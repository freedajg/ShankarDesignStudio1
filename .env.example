# Sweet Ginger Design Studio — environment
# Nothing is required for local development: `npm install && npm run dev` uses an
# embedded Postgres (PGlite), local file storage, a development payment provider
# and a console email logger. Production must set the values marked (prod).

APP_URL=http://localhost:3000

# Demo mode: embedded DB + local files filled with sample data, simulated payments.
# Automatically on in production when DATABASE_URL is not set (e.g. a fresh Vercel deploy).
# DEMO_MODE=true

# --- Database -------------------------------------------------------------
# (prod) Supabase Postgres connection string (transaction pooler URL is fine).
# Unset → embedded PGlite database in PGLITE_DATA_DIR.
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
PGLITE_DATA_DIR=.data/pglite

# --- File storage ---------------------------------------------------------
# local | supabase. (prod) supabase with private buckets:
#   artwork-originals, artwork-processed, design-previews, production-files
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=   # server-only secret — never expose to the browser

# --- Payments ---------------------------------------------------------------
# dev | razorpay. The dev provider moves no money and is refused when
# NODE_ENV=production unless ALLOW_DEV_PAYMENTS=true (staging demos only).
PAYMENT_PROVIDER=dev
# ALLOW_DEV_PAYMENTS=false
# DEV_PAYMENT_SECRET=           # optional; random per process if unset
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Email ------------------------------------------------------------------
# console | resend
EMAIL_PROVIDER=console
# RESEND_API_KEY=
EMAIL_FROM="Sweet Ginger Design Studio <orders@example.com>"
# STAFF_NOTIFY_EMAIL=orders@example.com

# --- Staff user creation (npm run db:user) ----------------------------------
# STAFF_PASSWORD=

# --- AI design generation (docs/AI_DESIGN_GENERATION.md) -------------------
# Server-only. Add a key to switch the "Generate with AI" feature on; without
# one the button stays visible but explains that AI isn't available yet.
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=            # optional fallback (or primary if no OpenAI key)
# AI_IMAGE_PROVIDER=auto     # auto | openai | gemini | off
# AI_FALLBACK_PROVIDER=auto  # auto | openai | gemini | none
# OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# AI_IMAGE_QUALITY=medium    # low | medium | high | auto (cost vs detail)
# AI_VARIATIONS=3            # options per generation (1-4)
# AI_MAX_GENERATIONS_PER_SESSION=10   # per browser, per 24 hours
# AI_TIMEOUT_MS=170000
