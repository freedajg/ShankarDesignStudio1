# Sweet Ginger Design Studio — environment
# Nothing is required for local development: `npm install && npm run dev` uses an
# embedded Postgres (PGlite), local file storage, a development payment provider
# and a console email logger. Production must set the values marked (prod).

APP_URL=http://localhost:3000

# --- Database -------------------------------------------------------------
# (prod) Supabase Postgres connection string (transaction pooler URL is fine).
# Unset → embedded PGlite database in PGLITE_DATA_DIR.
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
PGLITE_DATA_DIR=.data/pglite

# --- File storage ---------------------------------------------------------
# local | supabase. (prod) supabase with private buckets:
#   artwork-originals, artwork-processed, design-previews, production-files
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=.data/storage
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=   # server-only secret — never expose to the browser

# --- Payments ---------------------------------------------------------------
# dev | razorpay. The dev provider moves no money and is refused when
# NODE_ENV=production unless ALLOW_DEV_PAYMENTS=true (staging demos only).
PAYMENT_PROVIDER=dev
# ALLOW_DEV_PAYMENTS=false
# DEV_PAYMENT_SECRET=           # optional; random per process if unset
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# --- Email ------------------------------------------------------------------
# console | resend
EMAIL_PROVIDER=console
# RESEND_API_KEY=
EMAIL_FROM="Sweet Ginger Design Studio <orders@example.com>"
# STAFF_NOTIFY_EMAIL=orders@example.com

# --- Staff user creation (npm run db:user) ----------------------------------
# STAFF_PASSWORD=
